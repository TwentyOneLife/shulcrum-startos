{
  "name": "shulcrum-startos",
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "prettier": "prettier --write startos",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "knots-blake2b-startos": "github:paulscode/knots-blake2b-startos#main"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@vercel/ncc": "^0.38.3",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  }
}
