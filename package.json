{
  "name": "shulcrum-startos",
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "prettier": "prettier --write startos test",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "bitcoin-core-startos": "github:Start9Labs/bitcoin-core-startos#ec462fb2e463ab9f0fe924339a788d51b4d50ae5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  }
}
