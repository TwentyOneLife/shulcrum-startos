# .env.example, placeholders only. Copy to a PRIVATE location and fill in.
#
# SECURITY: real secrets must NEVER be committed. Homes for the real values:
#   - CI signing  -> GitHub repo Settings > Secrets and variables > Actions (GPG_PRIVATE_KEY, GPG_PASSPHRASE)
#   - Local use   -> a chmod 600 file in a private location outside the repo (e.g. ~/.config/…)
#   - GitHub PAT  -> the gh keyring via `gh auth login` (workspace-wide; not a per-repo .env)

# --- Release signing (used by .github/workflows/release.yml) ---
# ASCII-armored PRIVATE key of the TwentyOne.Life release-signing key (export: gpg --armor --export-secret-keys <KEYID>)
GPG_PRIVATE_KEY="-----BEGIN PGP PRIVATE KEY BLOCK----- REPLACE_ME -----END PGP PRIVATE KEY BLOCK-----"
# Passphrase protecting that key
GPG_PASSPHRASE="REPLACE_ME"

# --- GitHub auth (prefer `gh auth login`; this is a fallback only) ---
# Fine-grained PAT for the TwentyOneLife account. Prefer the gh keyring over a file.
# GITHUB_TOKEN="github_pat_REPLACE_ME"
